  dialogueLines:
  - speaker: {fileID: 11400000, guid: 4a8476c30006b8a4daa49dc578fdb97b, type: 2}
    line: "\u8BF6\u8BF6\u8BF6\uFF1F\uFF01\u4F60\u3001\u4F60\u8BF4\u4EC0\u4E48\uFF1F\uFF01\u6211\u662F\u5973\u795E\u554A\uFF01\u600E\u4E48\u80FD\u8DDF\u4F60\u53BB\u5F02\u4E16\u754C\uFF01"
