--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c24cb25e8efa32447821db9904202466, type: 3}
  m_Name: Story_Ch2_YellowBob_Rescue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 等等！你们听到了吗？有人在喊救命！
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 救...救命啊！有谁来救救我！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 那边！有个骑士被哥布林围住了！
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 哼！来吧！你们这些小怪物！我可是王国骑士·黄发Bob！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 她在挥剑...但是完全打不中啊？
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 不仅打不中，她好像还在笑？被哥布林打了还脸红？！
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 啊...被这样围攻...好、好羞耻...但是...好兴奋...
  dialogueOptions:
  - optionText: 救她！
    nextDialogue: {fileID: 11400000, guid: a7b8c9d0e1f2a3b4c5d6a7b8c9d0e1f2, type: 2}
  requiredNPC: []
  requiredLocations:
  - {fileID: 11400000, guid: 85f104bf33d75e54c95572ae1172cea7, type: 2}
  requiredItems: []
