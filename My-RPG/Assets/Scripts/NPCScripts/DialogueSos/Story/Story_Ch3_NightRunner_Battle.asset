--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c24cb25e8efa32447821db9904202466, type: 3}
  m_Name: Story_Ch3_NightRunner_Battle
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: 接招吧！爆裂魔法！！
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 哼！雕虫小技！
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 她的魔法被挡下来了！
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: 哈...哈...体力...用尽了...我站不起来了...
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 接下来交给我！看我的骑士突击！
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 什么？！
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 呃...打偏了...
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 哈！就这？
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 让我来！水之女神的祝福——治愈之术！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 她治愈了NightRunner？！
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 呜呜呜...手滑了...
  dialogueOptions:
  - optionText: "[趁机攻击！]"
    nextDialogue: {fileID: 11400000, guid: d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4c5, type: 2}
  requiredNPC: []
  requiredLocations: []
  requiredItems: []
  removeAfterPlay: 1
  removeTheseOnPlay: []
