  dialogueLines:
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: "\u7AD9\u4F4F\uFF01\u4E0D\u8BB8\u52A8\uFF01\u4F60\u4EEC\u662F\u4EC0\u4E48\u4EBA\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u554A\uFF0C\u6211\u4EEC\u53EA\u662F\u8DEF\u8FC7\u7684\u5192\u9669\u8005..."
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: "\u5192\u9669\u8005\uFF1F\u592A\u597D\u4E86\uFF01\u4F60\u4EEC\u6765\u5F97\u6B63\u597D\uFF01\u5FEB\u770B\u90A3\u8FB9\u90A3\u5EA7\u5C71\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u90A3\u5EA7\u5C71\u600E\u4E48\u4E86\uFF1F"
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: "\u6211\u8981\u7528\u7206\u88C2\u9B54\u6CD5\u628A\u5B83\u70B8\u6389\uFF01\u4F46\u662F...\u6211\u4F53\u529B\u4E0D\u591F\u4E86\uFF0C\u9700\u8981\u6709\u4EBA\u80CC\u6211\u56DE\u53BB\u3002"
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: "\u7B49\u7B49\uFF0C\u4F60\u4E3A\u4EC0\u4E48\u8981\u70B8\u5C71\u554A\uFF1F\uFF01"
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: "\u56E0\u4E3A\uFF01\u7206\u88C2\u9B54\u6CD5\u662F\u6700\u5F3A\u7684\uFF01\u53EA\u6709\u7206\u88C2\u9B54\u6CD5\u624D\u662F\u9B54\u6CD5\u7684\u771F\u8C1B\uFF01\u5176\u4ED6\u9B54\u6CD5\u90FD\u662F\u90AA\u9053\uFF01"
  dialogueOptions:
  - optionText: "\u5E2E\u5979\u642C\u9B54\u6CD5\u4E66"
    nextDialogue: {fileID: 11400000, guid: e5f6a7b8c9d0e1f2a3b4c5d6a7b8c9d0, type: 2}
