--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c24cb25e8efa32447821db9904202466, type: 3}
  m_Name: Story_Ch2_YellowBob_Join
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 谢谢你们救了我！我叫黄发Bob，是王国骑士团的...呃...骑士！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 你的剑法...好像不太准？
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 那、那是故意的！我在练习闪避技巧！而且我的防御力可是全骑士团最高的！
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 你刚才明明是在享受被怪物打吧...
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 才、才没有！总之！请让我加入你们的队伍！我可以用身体替你们挡住所有攻击！
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: 太好了！又多了一个肉盾！这样我放爆裂魔法就更安全了！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 一个废柴女神、一个只会爆裂的法师、一个打不中的骑士...这队伍真的没问题吗？
  dialogueOptions:
  - optionText: 出发冒险吧！
    nextDialogue: {fileID: 0}
  requiredNPC: []
  requiredLocations: []
  requiredItems: []
  removeAfterPlay: 1
  removeTheseOnPlay: []
  offerQuestOnEnd: {fileID: 0}
  requireCompleteQuests: []
  turnInQuest: {fileID: 0}
