  m_Name: Story_Ch2_YellowBob_Join
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: bc6c5cbb6dd6e6b47ad95398147cbeb2, type: 2}
    line: "\u8C22\u8C22\u4F60\u4EEC\u6551\u4E86\u6211\uFF01\u6211\u53EB\u9EC4\u53D1Bob\uFF0C\u662F\u738B\u56FD\u9A91\u58EB\u56E2\u7684...\u5443...\u9A91\u58EB\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u4F60\u7684\u5251\u6CD5...\u597D\u50CF\u4E0D\u592A\u51C6\uFF1F"
  - speaker: {fileID: 11400000, guid: bc6c5cbb6dd6e6b47ad95398147cbeb2, type: 2}
    line: "\u90A3\u3001\u90A3\u662F\u6545\u610F\u7684\uFF01\u6211\u5728\u7EC3\u4E60\u95EA\u907F\u6280\u5DE7\uFF01\u800C\u4E14\u6211\u7684\u9632\u5FA1\u529B\u53EF\u662F\u5168\u9A91\u58EB\u56E2\u6700\u9AD8\u7684\uFF01"
  - speaker: {fileID: 11400000, guid: 4a8476c30006b8a4daa49dc578fdb97b, type: 2}
    line: "\u4F60\u521A\u624D\u660E\u660E\u662F\u5728\u4EAB\u53D7\u88AB\u602A\u7269\u6253\u5427..."
  - speaker: {fileID: 11400000, guid: bc6c5cbb6dd6e6b47ad95398147cbeb2, type: 2}
    line: "\u624D\u3001\u624D\u6CA1\u6709\uFF01\u603B\u4E4B\uFF01\u8BF7\u8BA9\u6211\u52A0\u5165\u4F60\u4EEC\u7684\u961F\u4F0D\uFF01\u6211\u53EF\u4EE5\u7528\u8EAB\u4F53\u66FF\u4F60\u4EEC\u6321\u4F4F\u6240\u6709\u653B\u51FB\uFF01"
  - speaker: {fileID: 11400000, guid: 6294632fcfe225249ac5a8d248827d1b, type: 2}
    line: "\u592A\u597D\u4E86\uFF01\u53C8\u591A\u4E86\u4E00\u4E2A\u8089\u76FE\uFF01\u8FD9\u6837\u6211\u653E\u7206\u88C2\u9B54\u6CD5\u5C31\u66F4\u5B89\u5168\u4E86\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u4E00\u4E2A\u5E9F\u67F4\u5973\u795E\u3001\u4E00\u4E2A\u53EA\u4F1A\u7206\u88C2\u7684\u6CD5\u5E08\u3001\u4E00\u4E2A\u6253\u4E0D\u4E2D\u7684\u9A91\u58EB...\u8FD9\u961F\u4F0D\u771F\u7684\u6CA1\u95EE\u9898\u5417\uFF1F"
  dialogueOptions:
  - optionText: "\u51FA\u53D1\u5192\u9669\u5427\uFF01"
