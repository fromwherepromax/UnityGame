--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c24cb25e8efa32447821db9904202466, type: 3}
  m_Name: Story_Ch3_NightRunner_Appear
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 哼哼哼...终于找到你们了，勇者一行人。
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 你是谁？！
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 我乃魔王军四天王之一——暗夜行者·NightRunner！奉魔王之命，前来消灭你们！
  - speaker: {fileID: 11400000, guid: 0bc5327fda19cdc46b15353e7e4ed256, type: 2}
    line: 魔、魔王军？！完了完了完了！我们死定了！
  - speaker: {fileID: 11400000, guid: a89a7957c2f3fb44e91244ece8700098, type: 2}
    line: 终于来了吗...邪恶的存在！就让你见识一下爆裂魔法的威力！
  - speaker: {fileID: 11400000, guid: 7aadde4735a01f445883d832e772c293, type: 2}
    line: 就凭你们？一个哭哭啼啼的女神、一个放完魔法就倒的法师、一个打不中的骑士？
  - speaker: {fileID: 11400000, guid: 2851522d805326f4aaa4bb10b90bc3cd, type: 2}
    line: 你、你说什么！我要让你见识骑士的荣耀！
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: 全员准备战斗！
  dialogueOptions:
  - optionText: "[开战！]"
    nextDialogue: {fileID: 11400000, guid: c9d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4, type: 2}
  requiredNPC: []
  requiredLocations: []
  requiredItems: []
  removeAfterPlay: 1
  removeTheseOnPlay: []
