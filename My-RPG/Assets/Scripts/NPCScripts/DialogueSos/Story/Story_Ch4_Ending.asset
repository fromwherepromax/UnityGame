  dialogueLines:
  - speaker: {fileID: 11400000, guid: 4a8476c30006b8a4daa49dc578fdb97b, type: 2}
    line: "\u592A\u597D\u4E86\uFF01\u9B54\u738B\u6295\u964D\u4E86\uFF01\u4E16\u754C\u548C\u5E73\u4E86\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u867D\u7136\u8FC7\u7A0B\u4E00\u8A00\u96BE\u5C3D...\u4F46\u603B\u7B97\u662F\u7ED3\u675F\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: 4a8476c30006b8a4daa49dc578fdb97b, type: 2}
    line: "\u7B49\u7B49\uFF01\u6211\u56E0\u4E3A\u72AF\u4E86\u592A\u591A\u9519\uFF0C\u5929\u754C\u628A\u6211\u9664\u540D\u4E86\uFF01\u6211\u56DE\u4E0D\u53BB\u4E86\uFF01"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "...\u4F60\u8FD9\u662F\u8981\u8D56\u5728\u6211\u8EAB\u8FB9\u4E00\u8F88\u5B50\uFF1F"
  - speaker: {fileID: 11400000, guid: 4a8476c30006b8a4daa49dc578fdb97b, type: 2}
    line: "\u563F\u563F~\u4F60\u4E0D\u662F\u8BF4\u8981\u5E26\u6211\u4E00\u8D77\u8D70\u5417\uFF1F\u8FD9\u5C31\u662F\u547D\u8FD0\u7684\u5B89\u6392~"
  - speaker: {fileID: 11400000, guid: 6294632fcfe225249ac5a8d248827d1b, type: 2}
    line: "\u4EE5\u540E\u6211\u4F1A\u7EE7\u7EED\u7528\u7206\u88C2\u9B54\u6CD5\u5B88\u62A4\u8FD9\u4E2A\u4E16\u754C\u7684\uFF01\u6BCF\u5929\u4E00\u53D1\uFF01"
  - speaker: {fileID: 11400000, guid: bc6c5cbb6dd6e6b47ad95398147cbeb2, type: 2}
    line: "\u6211\u4F1A\u6210\u4E3A\u738B\u56FD\u6700\u5F3A\u7684\u9A91\u58EB\uFF01\u867D\u7136\u73B0\u5728\u8FD8\u662F\u6253\u4E0D\u4E2D..."
  - speaker: {fileID: 11400000, guid: 53eaaa0c8d4d9804dbed9f544f0fe184, type: 2}
    line: "\u6211...\u6211\u80FD\u7EE7\u7EED\u5728\u5BB6\u770B\u6F2B\u753B\u5417\uFF1F"
  - speaker: {fileID: 11400000, guid: f08b62598cfd73d4f88944f17a08c3b7, type: 2}
    line: "\u8FD9\u5C31\u662F\u6211\u7684\u5192\u9669\u961F\u4F0D\u2014\u2014\u4E00\u4E2A\u5E9F\u67F4\u5973\u795E\u3001\u4E00\u4E2A\u7206\u88C2\u72C2\u3001\u4E00\u4E2A\u88AB\u8650\u9A91\u58EB\u3001\u4E00\u4E2A\u793E\u6050\u9B54\u738B\u3002\u867D\u7136\u90FD\u662F\u95EE\u9898\u513F\u7AE5...\u4F46\u8FD9\u5C31\u662F\u6211\u4EEC\u7684\u6545\u4E8B\u3002"
  dialogueOptions:
  - optionText: "[\u5192\u9669\u7EE7\u7EED...]"
